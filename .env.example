# Optional server-side credentials. Alternatively, enter a key for this session in Settings.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# To use server-side keys on Vercel, set up GitHub sign-in and/or a workspace password.
# GitHub OAuth app; callback URL: https://<your-domain>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user ids allowed to use server keys. Empty allows nobody.
ORBIT_ALLOWED_GITHUB_IDS=
# Optional: sign sessions with this instead of a key derived from GITHUB_CLIENT_SECRET.
ORBIT_SESSION_SECRET=
# Workspace password, entered in Settings. Works alongside GitHub sign-in until removed.
ORBIT_ACCESS_TOKEN=
# Local development only. Explicitly enables installed, signed-in Codex / Claude CLIs.
ORBIT_ENABLE_LOCAL_CLI=false
PORT=5173
