# Optional server-side credentials. Alternatively, enter a key for this session in Settings.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required to use server-side keys on Vercel. Enter this in Settings > Workspace password.
# Changing it signs out every device that chose "Remember this device".
ORBIT_ACCESS_TOKEN=
# Local development only. Explicitly enables installed, signed-in Codex / Claude CLIs.
ORBIT_ENABLE_LOCAL_CLI=false
PORT=5173
